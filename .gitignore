# ==========================================
# SkillBridge Platform - Root .gitignore
# ==========================================

# Secrets and local configurations (NEVER commit credentials)
application.properties
**/application.properties
**/application-local.properties
.env
.env.local
.env.*.local
*.env

# Local downloaded tools and binaries
/maven/
/maven/**

# ------------------------------------------
# Backend (Java / Spring Boot / Maven)
# ------------------------------------------
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/*.class
**/*.jar
**/*.war
**/*.nar
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# ------------------------------------------
# Frontend (Node / React / Vite)
# ------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# ------------------------------------------
# AI Microservice (Python / Virtual Environment)
# ------------------------------------------
**/venv/
**/env/
**/ENV/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/build/
**/develop-eggs/
**/eggs/
**/.eggs/
**/*.egg-info/
**/*.egg
**/.pytest_cache/

# ------------------------------------------
# IDE & Operating System Files
# ------------------------------------------
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
